[Unit]
Description=dbui SQLite web workbench
After=network.target

[Service]
Type=simple
User=dbui
Group=dbui
ExecStartPre=/usr/local/bin/dbui --config /etc/dbui/config.json --check
ExecStart=/usr/local/bin/dbui --config /etc/dbui/config.json
Restart=on-failure
RestartSec=2
TimeoutStopSec=12
KillSignal=SIGTERM
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryHigh=64M
MemoryMax=128M
TasksMax=16
LimitNOFILE=512
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

# Replace these examples with the exact configured files/directories.
ReadOnlyPaths=/srv/cloudio/data
ReadWritePaths=/srv/analytico/data /srv/dbui/queries

[Install]
WantedBy=multi-user.target
